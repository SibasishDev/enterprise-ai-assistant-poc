NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_ai

COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_CLIENT_ID=your-client-id
COGNITO_REGION=ap-south-1

AWS_REGION=ap-south-1
S3_BUCKET_NAME=
SQS_DOCUMENT_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/document-ingestion

BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

BEDROCK_CHAT_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_RERANK_MODEL_ARN=arn:aws:bedrock:ap-south-1::foundation-model/cohere.rerank-v3-5:0