{
  "name": "enterprise-ai-backend",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --watch . --ext ts --exec tsx src/app.ts",
    "dev:worker": "node --experimental-strip-types --watch dist/workers/worker.js",
    "build": "tsc",
    "start": "node dist/app.js",
    "start:worker": "node dist/workers/worker.js",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1129.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1129.0",
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/client-sqs": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "aws-jwt-verify": "^5.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pdf-parse": "^2.4.5",
    "pdf-text-reader": "^5.1.1",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6",
    "prisma": "^7.10.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
